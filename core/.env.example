# =============================================================================
# SoroScope Core — Environment Configuration (Issue #39)
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Environment variables always take precedence over .env values.
#
# PRODUCTION REQUIREMENTS
# When APP_ENV=production the server enforces stricter validation:
#   - DATABASE_URL must be a PostgreSQL URL (not SQLite)
#   - NETWORK_PASSPHRASE must be the mainnet passphrase
#   - SOROBAN_RPC_URL must not point at Stellar testnet
#   - CORS_ALLOWED_ORIGINS must list at least one explicit origin
#   - JWT_PRIVATE_KEY must be provided
# =============================================================================


# --- Deployment environment --------------------------------------------------
# Set to "production" to enable strict config validation.
# Default: development
APP_ENV=development


# --- Server ------------------------------------------------------------------
# TCP port the HTTP server listens on.
# Default: 8080
SERVER_PORT=8080


# --- Logging -----------------------------------------------------------------
# Tracing filter directive. Supports per-module overrides, e.g.:
#   soroscope_core=debug,tower_http=warn
# Default: info
RUST_LOG=info

# Emit structured JSON log lines when set to "true".
# Default: false
LOG_FORMAT_JSON=false


# --- Stellar / Soroban RPC ---------------------------------------------------
# Primary Soroban RPC endpoint.
# Default: Stellar testnet (NOT suitable for production)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase — must match SOROBAN_RPC_URL's network.
# Testnet:  "Test SDF Network ; September 2015"
# Mainnet:  "Public Global Stellar Network ; September 2015"
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# JSON-encoded array of RPC provider objects for multi-provider failover/consensus.
# When absent the server uses SOROBAN_RPC_URL as a single provider.
# Example:
#   RPC_PROVIDERS=[{"name":"blockdaemon","url":"https://soroban.blockdaemon.com","auth_header":"X-API-Key","auth_value":"MY_KEY"}]
RPC_PROVIDERS=


# --- Database ----------------------------------------------------------------
# Connection URL for the job queue and fee store.
# SQLite (development only): sqlite://soroscope.db
# PostgreSQL (recommended):  postgres://user:pass@localhost:5432/soroscope
# Default: sqlite://soroscope.db
DATABASE_URL=sqlite://soroscope.db


# --- Redis -------------------------------------------------------------------
# Redis connection URL (reserved for distributed cache migration).
# Default: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379


# --- Authentication ----------------------------------------------------------
# PEM-encoded RSA private key for RS256 JWT signing.
# When unset a throwaway key is generated on startup (NOT suitable for production).
# JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----


# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed CORS origins.
# Empty → allow all origins (development fallback — not suitable for production).
# Example: https://app.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=

# Alias for CORS_ALLOWED_ORIGINS (backwards compatibility).
ALLOWED_ORIGINS=


# --- Webhooks ----------------------------------------------------------------
# Pre-shared HMAC secret for inbound webhook validation.
# Empty → webhook HMAC validation is disabled.
INBOUND_WEBHOOK_SECRET=


# --- Provider registry -------------------------------------------------------
# Stable identifier for this node in the gossip registry.
# When empty a random UUID is generated at startup.
REGISTRY_INSTANCE_ID=

# Public base URL announced to registry peers.
# When empty defaults to http://127.0.0.1:<SERVER_PORT>.
REGISTRY_PUBLIC_URL=

# JSON array or comma-separated list of seed peer base URLs.
# Example: https://peer-a.example.com,https://peer-b.example.com
REGISTRY_SEED_PEERS=


# --- Health & gossip ---------------------------------------------------------
# Interval (seconds) between health-check pings to peers. Default: 30
HEALTH_CHECK_INTERVAL_SECS=30

# Interval (seconds) between gossip sync rounds. Default: 30
GOSSIP_INTERVAL_SECS=30


# --- Simulation --------------------------------------------------------------
# Per-request simulation timeout in seconds. Default: 30
SIMULATION_TIMEOUT_SECS=30

# Execution mode: "failover" (try providers in order) or "consensus" (require agreement).
# Default: failover
SIMULATION_MODE=failover


# --- Job queue ---------------------------------------------------------------
# Per-job execution timeout in seconds. Default: 300
JOB_TIMEOUT_SECS=300

# Maximum number of jobs running concurrently. Default: 10
MAX_CONCURRENT_JOBS=10

# Thread count for the dedicated event worker pool. Default: 4
EVENT_WORKER_THREADS=4


# --- Fee market --------------------------------------------------------------
# Interval (seconds) between fee data collection sweeps. Default: 5
FEE_COLLECTION_INTERVAL_SECS=5

# Number of days to retain historical fee data. Default: 30
FEE_RETENTION_DAYS=30

# Enable fee market analysis and predictions. Default: true
FEE_ANALYSIS_ENABLED=true


# --- Emergency controls ------------------------------------------------------
# Set to "true" to pause all message-verification endpoints. Default: false
EMERGENCY_VERIFICATION_PAUSED=false


# --- Disk cache (L2) ---------------------------------------------------------
# Filesystem path for the disk-persistent L2 simulation cache.
# Empty → L2 disabled (runs L1 in-memory only).
# Example: /var/lib/soroscope/cache
DISK_CACHE_PATH=

# Maximum ledger age (in ledgers) before an L2 entry is treated as stale.
# Default: 100  (~8 minutes at 5 s/ledger)
MAX_LEDGER_AGE=100


# --- WebSocket event bus -----------------------------------------------------
# Per-subscriber in-flight event buffer size. Clamped to [16, 65536]. Default: 256
EVENT_BUS_CAPACITY=256
